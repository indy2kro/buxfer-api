{
    "name": "indy2kro/buxfer-api",
    "type": "library",
    "description": "Buxfer API client library",
    "keywords": [
        "buxfer",
        "api",
        "client",
        "finance",
        "guzzle"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Cristi RADU",
            "email": "indy2kro@gmail.com",
            "homepage": "https://github.com/indy2kro"
        }
    ],
    "require": {
        "php": ">=8.3",
        "guzzlehttp/guzzle": "^7.9 || ^8.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.64",
        "phpstan/phpstan": "^2",
        "phpstan/phpstan-phpunit": "^2",
        "phpstan/phpstan-strict-rules": "^2",
        "phpunit/phpunit": "^11 || ^12",
        "rector/rector": "^2"
    },
    "autoload": {
        "psr-4": {
            "BuxferApi\\": "src/BuxferApi/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "BuxferApi\\Test\\": "tests/"
        }
    },
    "scripts": {
        "quality": [
            "vendor/bin/phpunit",
            "vendor/bin/php-cs-fixer fix --dry-run --diff",
            "php -d memory_limit=512M vendor/bin/phpstan analyse --no-progress",
            "vendor/bin/rector --dry-run"
        ],
        "fix": [
            "vendor/bin/php-cs-fixer fix",
            "vendor/bin/rector"
        ]
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "platform": {
            "php": "8.3.0"
        },
        "sort-packages": true
    },
    "suggest": {
        "ext-curl": "Faster HTTP transport for Guzzle than PHP streams."
    },
    "homepage": "https://github.com/indy2kro/buxfer-api",
    "support": {
        "issues": "https://github.com/indy2kro/buxfer-api/issues",
        "source": "https://github.com/indy2kro/buxfer-api",
        "security": "https://github.com/indy2kro/buxfer-api/security/policy"
    }
}
