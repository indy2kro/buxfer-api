{
    "name": "indy2kro/buxfer-api",
    "type": "library",
    "description": "Buxfer API client library",
    "keywords": [
        "buxfer"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Cristi RADU",
            "email": "indy2kro@gmail.com",
            "homepage": "https://github.com/indy2kro"
        }
    ],
    "require": {
        "php": ">=8.3",
        "ext-curl": "*",
        "ext-json": "*",
        "guzzlehttp/guzzle": "^7.9 || ^8.0"
    },
    "require-dev": {
        "squizlabs/php_codesniffer": ">=3.7",
        "phpunit/phpunit": "^11 || ^12",
        "phpstan/phpstan": "^2",
        "phpstan/phpstan-phpunit": "^2",
        "rector/rector": "^2"
    },
    "autoload": {
        "psr-4": {
            "BuxferApi\\": "src/BuxferApi/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "BuxferApi\\Test\\": "tests/"
        }
    },
    "scripts": {
        "quality": [
            "vendor/bin/phpunit",
            "vendor/bin/phpcs",
            "php -d memory_limit=512M vendor/bin/phpstan analyse --no-progress",
            "vendor/bin/rector --dry-run"
        ]
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "platform": {
            "php": "8.3.0"
        },
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}
